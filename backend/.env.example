# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://simulation:simulation_dev_password@localhost:5432/simulation_game?schema=public
DATABASE_POOL_SIZE=10
DATABASE_LOG_LEVEL=warn

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_FAMILY=4

# JWT (CHANGE IN PRODUCTION - min 32 chars for HS256)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=simulation-game
JWT_AUDIENCE=simulation-game-client

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:1080

# Simulation
SIM_TICK_RATE=20
SIM_MAX_PLAYERS_PER_WORLD=5000
SIM_ACTION_QUEUE_SIZE=10000
SIM_STATE_BROADCAST_INTERVAL=50
SIM_SNAPSHOT_INTERVAL=300000

# Observability
LOG_LEVEL=debug
METRICS_ENABLED=true
TRACING_ENABLED=true
SENTRY_DSN=
OTLP_ENDPOINT=

# Mail (Maildev local)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@simulation.game

# File Upload
UPLOAD_MAX_FILE_SIZE=10485760